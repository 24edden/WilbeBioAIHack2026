# Copy to .env and edit. Only RUN_MODE matters for the mock demo path.

# mock | live
RUN_MODE=mock

# Multiplier on mock thinking time. 1.0 = demo pacing, 0 = instant (tests).
MOCK_LATENCY_SCALE=1.0

# --- live mode only ---
# OpenAI reasoning. For GPT-Rosalind use gpt-rosalind-research and a key from
# an approved project. See Context/rosalind-integration.md for setup/checks.
REASONING_BASE_URL=https://api.openai.com/v1
REASONING_API_KEY=
REASONING_MODEL=gpt-4o-mini
# auto selects Responses for gpt-rosalind-research; other models keep chat.
# Set responses or chat_completions explicitly for a compatible gateway.
REASONING_API=auto
REASONING_TIMEOUT_SECONDS=180
# Output budget includes internal reasoning and the visible answer.
REASONING_MAX_OUTPUT_TOKENS=16000

# NVIDIA BioNeMo NIMs. Either a hosted endpoint or a local container on Brev.
BIONEMO_BASE_URL=http://localhost:8000
BIONEMO_API_KEY=
BIONEMO_VARIANT_MODEL=evo2
BIONEMO_EMBED_MODEL=esm2-650m
