# Keys stay on the trusted server. Never paste keys into the browser or commit .env.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
NGC_API_KEY=
NVIDIA_API_KEY=
# User-authorized temporary model. Astra requests use high reasoning.
# To use the separately entitled Rosalind project, explicitly select gpt-rosalind-research.
TEAM_TBD_MODEL=gpt-6-astra
# Technical waits, not spending budgets. No automatic retries after a timeout.
# Request range 60–1800; agent range 120–7200 and at least request+30 seconds.
TEAM_TBD_MODEL_REQUEST_TIMEOUT_SECONDS=600
TEAM_TBD_AGENT_TIMEOUT_SECONDS=1800
# Legacy ROSALIND_MODEL is used only when TEAM_TBD_MODEL is unset. No automatic fallback.
# Optional private, self-hosted Boltz-2 origin, e.g. http://127.0.0.1:8000
BOLTZ2_NIM_URL=
NIM_TIMEOUT_SECONDS=300
# Advisory is the default: crossing cumulative thresholds warns and continues.
# Set enforced to stop at cumulative input/output/request/tool/time budgets instead.
TEAM_TBD_BUDGET_MODE=advisory
# Provider advisory thresholds per ModelSession; reached thresholds warn and continue.
# Integer ranges: requests 1–1000; tools 1–2000.
TEAM_TBD_MAX_MODEL_REQUESTS=120
TEAM_TBD_MAX_TOOL_CALLS=180
# Specialist requests include reasoning in this allowance; synthesis has its own setting below.
# Integer range 2048–64000; applies to each model turn, not a cumulative per-role budget.
TEAM_TBD_AGENT_MAX_OUTPUT_TOKENS=24000
# Coordinator and reviewer need room for the evidence synthesis and hypothesis ledger.
# Separate technical response allowance, including reasoning; range 8192–128000.
# Research-brief synthesis, review, finalization and repair use the same role allowances.
TEAM_TBD_SYNTHESIS_MAX_OUTPUT_TOKENS=48000
# Shared observed output threshold. Enforced mode reserves the next full allowance.
# Integer range 16000–2000000.
TEAM_TBD_MAX_OUTPUT_TOKENS=300000
# Shared observed input budget, including repeated context. Integer range 50000–10000000.
# This is cumulative across requests, not a model context-window setting.
# Usage is known after each response; advisory warns, enforced stops the next dispatch.
TEAM_TBD_MAX_INPUT_TOKENS=2000000
ROSALIND_EMBEDDED_WORKER=1
ROSALIND_MAX_SECONDS=1200
ROSALIND_MAX_TOOL_CALLS=80
ROSALIND_DEMO_DELAY=0.7
OPENAI_AGENTS_DISABLE_TRACING=1
# Optional deployment locations. Blank entries use the existing application defaults.
# Use a new private runtime/port for isolated development; never test on production state.
ROSALIND_RUNTIME=
TEAM_TBD_LIFE_SCIENCES_PLUGIN_ROOT=
TEAM_TBD_DATA_ROOT=
TEAM_TBD_LEON_ROOT=
TEAM_TBD_HYPOTHESIS_ROOT=
TEAM_TBD_GSE28460_ROOT=
