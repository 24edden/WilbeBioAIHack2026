# Copy to .env and edit. Only RUN_MODE matters for the mock demo path.

# mock | live
RUN_MODE=mock

# Multiplier on mock thinking time. 1.0 = demo pacing, 0 = instant (tests).
MOCK_LATENCY_SCALE=1.0

# --- live mode only ---
# OpenAI / GPT-Rosalind (OpenAI-compatible chat completions endpoint)
REASONING_BASE_URL=https://api.openai.com/v1
REASONING_API_KEY=
REASONING_MODEL=gpt-4o-mini

# NVIDIA BioNeMo NIMs. Either a hosted endpoint or a local container on Brev.
BIONEMO_BASE_URL=http://localhost:8000
BIONEMO_API_KEY=
BIONEMO_VARIANT_MODEL=evo2
BIONEMO_EMBED_MODEL=esm2-650m
