{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "team-tbd-run-view/1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "description": "Snapshot export time, not a claim that the mutable originating service has stopped."
    },
    "raw_export": {
      "$ref": "#/$defs/FileRef"
    },
    "environment_id": {
      "type": "string"
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_scope": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "title",
        "data_mode",
        "dataset_scope",
        "limitations"
      ],
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "text",
        "source_name",
        "sha256"
      ],
      "additionalProperties": false,
      "description": "Exact user text including whitespace. Never rewrite from a brief or case default."
    },
    "state": {
      "type": "object",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {},
        "review_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "stage",
        "error",
        "review_status"
      ],
      "additionalProperties": false,
      "description": "Literal source state. An accepted handoff, completed model call or contract check is not equivalent to scientific validation."
    },
    "datasets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "findings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "evidence": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "decisions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "handoffs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "claims": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Claim"
      }
    },
    "timeline": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "quality_checks": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "followups": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "executions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "artifacts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "skills": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "receipts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Record"
          }
        },
        "usage": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "configuration",
        "receipts",
        "usage"
      ],
      "additionalProperties": false
    },
    "briefs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "source_locations": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "as_of",
    "raw_export",
    "environment_id",
    "case",
    "hypothesis",
    "state",
    "datasets",
    "findings",
    "evidence",
    "decisions",
    "handoffs",
    "claims",
    "timeline",
    "quality_checks",
    "followups",
    "executions",
    "artifacts",
    "skills",
    "models",
    "briefs",
    "source_locations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team TBD frozen run view 1.0.0",
  "description": "A lossless source-linked visualization index. The separately hashed full raw export is authoritative. Null means not captured; an empty array means captured and empty. No missing value may be inferred from another run. This is recorded rationale and work products, not private model chain of thought.",
  "$defs": {
    "FileRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Bundle-root-relative URL path. No parent traversal, absolute path, scheme, query or fragment. All file references resolve from manifest.json, never from the referring run JSON."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "media_type"
      ],
      "additionalProperties": false
    },
    "Record": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_pointer": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC 6901 pointer into this run’s authoritative raw_export. Null only for externally sourced records; data must then identify its source_file."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Unmodified source record. Preserve failures, nulls, scopes, caveats, references and version numbers."
        },
        "decision_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "raw_pointer",
        "data"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "included",
            "missing",
            "excluded",
            "unavailable",
            "external_reference"
          ]
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_pointers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "file",
        "source_url",
        "source_path",
        "expected_sha256",
        "run_ids",
        "raw_pointers",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "included"
              }
            }
          },
          "then": {
            "properties": {
              "file": {
                "$ref": "#/$defs/FileRef"
              }
            }
          },
          "else": {
            "properties": {
              "file": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "relative_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "sha256",
        "bytes",
        "url",
        "provenance",
        "asset_id",
        "raw_pointer",
        "data"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "decision_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "evidence_ids",
        "sources",
        "decision_version",
        "scope",
        "raw_pointer",
        "data"
      ],
      "additionalProperties": false
    },
    "Environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "local",
            "brev",
            "github",
            "other"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "source_path",
        "source_url",
        "github_url",
        "git_commit",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
