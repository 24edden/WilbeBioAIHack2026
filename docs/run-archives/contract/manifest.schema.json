{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "team-tbd-archive/1.0.0"
    },
    "bundle_id": {
      "type": "string"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "environment_id": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "view": {
            "$ref": "#/$defs/FileRef"
          },
          "raw_export": {
            "$ref": "#/$defs/FileRef"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/$defs/FileRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "environment_id",
          "status",
          "view",
          "raw_export",
          "report"
        ],
        "additionalProperties": false
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Environment"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "scope",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Collector version, source revision, collection window, consistency checks, repository status and scope. Never include credentials."
    },
    "recommended_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": true,
      "description": "Explicit curator choice and rationale. Never infer chronological order from opaque run IDs."
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "frozen_at",
    "title",
    "runs",
    "environments",
    "assets",
    "omissions",
    "provenance"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team TBD immutable archive manifest 1.0.0",
  "description": "Entry point for a portable run bundle. Paths resolve from this file’s containing directory. Content SHA-256 hashes apply to exact file bytes; they are distinct from application content_sha256. Bundle checksums and release provenance provide integrity, not cryptographic authenticity.",
  "$defs": {
    "FileRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Bundle-root-relative URL path. No parent traversal, absolute path, scheme, query or fragment. All file references resolve from manifest.json, never from the referring run JSON."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "media_type"
      ],
      "additionalProperties": false
    },
    "Record": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_pointer": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC 6901 pointer into this run’s authoritative raw_export. Null only for externally sourced records; data must then identify its source_file."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Unmodified source record. Preserve failures, nulls, scopes, caveats, references and version numbers."
        },
        "decision_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "raw_pointer",
        "data"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "included",
            "missing",
            "excluded",
            "unavailable",
            "external_reference"
          ]
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_pointers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "file",
        "source_url",
        "source_path",
        "expected_sha256",
        "run_ids",
        "raw_pointers",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "included"
              }
            }
          },
          "then": {
            "properties": {
              "file": {
                "$ref": "#/$defs/FileRef"
              }
            }
          },
          "else": {
            "properties": {
              "file": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "relative_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "sha256",
        "bytes",
        "url",
        "provenance",
        "asset_id",
        "raw_pointer",
        "data"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "decision_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "evidence_ids",
        "sources",
        "decision_version",
        "scope",
        "raw_pointer",
        "data"
      ],
      "additionalProperties": false
    },
    "Environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "local",
            "brev",
            "github",
            "other"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "source_path",
        "source_url",
        "github_url",
        "git_commit",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
